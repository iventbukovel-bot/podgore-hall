function renderEditor(){packageEditor.innerHTML=cfg.packages.map((p,i)=>`<div class="admin-card"><h3 style="font-size:29px">Пакет ${i+1}</h3><div class="admin-grid"><div><label>Назва</label><input data-p="${i}" data-f="name" value="${p.name}"></div><div><label>Ціна на особу</label><input type="number" data-p="${i}" data-f="price" value="${p.price}"></div></div><label>Підзаголовок</label><input data-p="${i}" data-f="sub" value="${p.sub}"><label>Що входить — кожен пункт з нового рядка</label><textarea rows="6" data-p="${i}" data-f="items">${p.items.join('\n')}</textarea></div>`).join('')}
savePackages.onclick=()=>{$$('#packageEditor [data-p]').forEach(x=>{let p=cfg.packages[+x.dataset.p],f=x.dataset.f;p[f]=f==='price'?+x.value:f==='items'?x.value.split('\n').map(s=>s.trim()).filter(Boolean):x.value});save();renderPackages();updateCalc();alert('Пакети збережено')};
heroUpload.onchange=async e=>{if(e.target.files[0]){cfg.hero=await fileToData(e.target.files[0]);save();renderPhotos()}};hallUpload.onchange=async e=>{if(e.target.files[0]){cfg.hall=await fileToData(e.target.files[0]);save();renderPhotos()}};featureUpload.onchange=async e=>{cfg.features=await Promise.all([...e.target.files].slice(0,3).map(fileToData));save();renderPhotos()};clearPhotos.onclick=()=>{cfg.hero='';cfg.hall='';cfg.features=[];save();renderPhotos()};saveContacts.onclick=()=>{cfg.contact.phone=adminPhone.value;cfg.contact.email=adminEmail.value;save();renderContact();alert('Контакти збережено')};
function renderLeads(){leadList.innerHTML=leads.length?leads.map(l=>`<div class="admin-card"><b>${l.name}</b> · ${l.phone}<br><small>${l.date} · ${l.event} · ${l.pack} · ${l.guests} гостей</small>${l.msg?`<p>${l.msg}</p>`:''}</div>`).join(''):'<p>Заявок ще немає.</p>'}clearLeads.onclick=()=>{if(confirm('Очистити всі заявки?')){leads=[];localStorage.setItem(LEADS,'[]');renderLeads()}};
function initReveal(){let els=$$('.reveal:not(.in)');if(!('IntersectionObserver'in window)){els.forEach(x=>x.classList.add('in'));return}let io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.1});els.forEach(x=>io.observe(x))}
year.textContent=new Date().getFullYear();renderPackages();renderExtras();renderFormats();renderPhotos();renderContact();updateCalc();initReveal();
})();
</script>
</body>
</html>
